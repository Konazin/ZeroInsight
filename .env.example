# Brave CDP (sessao ja logada via scripts/start_brave_debug.bat)
CDP_PORT=9222
BRAVE_EXECUTABLE_PATH=
ZEROINSIGHT_APP_DATA_DIR=
ZEROINSIGHT_OUTPUT_DIR=
ZEROINSIGHT_UI_THEME=dark

# Pagina alvo para extracao
TARGET_URL=https://app.dino.com.br/Gerenciador2/dashboard

# Groq API
GROQ_API_KEY=
GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# OpenAI Platform
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_TEXT_MODEL=gpt-5.4-mini
OPENAI_REASONING_MODEL=gpt-5.5
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_FORMAT=png
OPENAI_IMAGE_BACKGROUND=opaque
OPENAI_VISION_MODEL=gpt-5.5

# Local image fallback
LOCAL_IMAGE_MODEL_PATH=

# Blog juridico
BLOG_BRAND_NAME=Sua Legal Tech
SCREENSHOTS_DIR=screenshots
POSTS_DIR=posts

# Instagram Stories (revisao/publicacao manual)
STORIES_DIR=stories
STORY_WIDTH=1080
STORY_HEIGHT=1920
STORY_SAFE_TOP=240
STORY_SAFE_BOTTOM=280
STORY_SAFE_SIDE=72
STORY_DEFAULT_TEMPLATE=legal_clean
STORY_BRAND_NAME=Requisite
STORY_BRAND_PRIMARY_COLOR=#111827
STORY_BRAND_SECONDARY_COLOR=#2563EB
STORY_LOGO_PATH=
IMAGE_PROVIDER=local

# Marca / IA
DEFAULT_BRAND_PROFILE_ID=
DEFAULT_TEXT_PROVIDER=mock
DEFAULT_IMAGE_PROVIDER=local
DEFAULT_VISION_PROVIDER=mock
TEXT_PROVIDER=mock
VISION_PROVIDER=mock
ALLOW_EXTERNAL_AI_FOR_BRAND_DOCS=false

# Custom OpenAI-compatible providers
CUSTOM_TEXT_BASE_URL=
CUSTOM_TEXT_ENDPOINT=
CUSTOM_TEXT_MODEL=
CUSTOM_TEXT_API_KEY=

CUSTOM_IMAGE_BASE_URL=
CUSTOM_IMAGE_ENDPOINT=
CUSTOM_IMAGE_MODEL=
CUSTOM_IMAGE_API_KEY=

# Backend/frontend local
ZEROINSIGHT_BACKEND_HOST=127.0.0.1
ZEROINSIGHT_BACKEND_PORT=8765
ZEROINSIGHT_FRONTEND_URL=http://127.0.0.1:5173

# Configuracao avancada de providers
AI_PROVIDERS_JSON={}

# Log de execucoes (JSONL)
OUTPUT_FILE=results.jsonl
