{
  "name": "zeroinsight",
  "version": "2.0.1",
  "description": "ZeroInsight — Gerador de Stories com IA",
  "author": "RequisiteRPV LTDA",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.requisite.zeroinsight",
    "productName": "ZeroInsight",
    "copyright": "Copyright © 2026 RequisiteRPV LTDA",
    "directories": {
      "output": "../dist-electron",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZeroInsight",
      "deleteAppDataOnUninstall": false
    },
    "extraResources": [
      {
        "from": "../dist/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
